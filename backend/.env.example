# GARUDA Backend Environment Variables (Source of Truth: ARCHITECTURE Section 10)

APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000

# Supabase Session Pooler connection strings (South Asia / Mumbai aws-0-ap-south-1.pooler.supabase.com:5432)
# Backend converts raw postgresql:// to postgresql+psycopg:// and ensures sslmode=require
DATABASE_URL=postgresql+psycopg://postgres.<dev-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
TEST_DATABASE_URL=postgresql+psycopg://postgres.<test-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Authentication & Security
JWT_SECRET=replace_with_64_plus_character_secure_random_string_garuda_secret_key_2026
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Rate Limiting & Limits
RATE_LIMIT_ANALYZE=30/minute
MAX_QR_UPLOAD_MB=5

# Email Verification (Disabled by default, required in Chunk 10)
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Phase 2 (Designed, not built)
