APP_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (Session pooler) - never commit backend/.env
DATABASE_URL=postgresql://postgres.<dev-ref>:<password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
TEST_DATABASE_URL=postgresql://postgres.<test-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Auth
JWT_SECRET=replace_with_64_plus_character_secure_random_string_garuda_secret_key_2026
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Limits
RATE_LIMIT_ANALYZE=30/minute
MAX_QR_UPLOAD_MB=5

# Email verification (chunk 10)
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
